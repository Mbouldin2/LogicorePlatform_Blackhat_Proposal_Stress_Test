// =============================================================================
// ZinkPen — PostgreSQL schema (Prisma). Designed for Supabase Postgres.
// Run: npm run db:generate && npm run db:push
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanId {
  starter
  professional
  executive
  government
}

enum MemberRole {
  owner
  admin
  editor
  viewer
}

enum DocStatus {
  draft
  in_review
  final
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      PlanId   @default(starter)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  createdAt DateTime @default(now())

  members      Membership[]
  projects     Project[]
  brandVoices  BrandVoice[]
  brandKits    BrandKit[]
  usage        UsageRecord[]
  generations  Generation[]
}

model User {
  id        String   @id // mirrors Supabase auth.users.id
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships Membership[]
  documents   Document[]
  generations Generation[]
}

model Membership {
  id     String     @id @default(cuid())
  role   MemberRole @default(editor)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String

  @@unique([userId, orgId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#5b63f0")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]
  folders   Folder[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  documents Document[]
}

model Document {
  id        String    @id @default(cuid())
  title     String
  type      String    @default("article")
  content   String    @default("")
  words     Int       @default(0)
  status    DocStatus @default(draft)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  folder    Folder?   @relation(fields: [folderId], references: [id])
  folderId  String?
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  versions DocumentVersion[]
}

model DocumentVersion {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  content    String
  label      String?
  createdAt  DateTime @default(now())
}

model BrandVoice {
  id          String   @id @default(cuid())
  name        String
  description String?
  traits      String[]
  sampleText  String   @default("")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  createdAt   DateTime @default(now())
}

model BrandKit {
  id        String   @id @default(cuid())
  name      String
  colors    String[]
  fontHeading String @default("Inter")
  fontBody    String @default("Inter")
  logoUrl   String?
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  createdAt DateTime @default(now())
}

model SavedPrompt {
  id        String   @id @default(cuid())
  title     String
  body      String
  orgId     String
  createdAt DateTime @default(now())
}

model Generation {
  id        String   @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  feature   String   // studio | humanizer | grammar | research | proposal | visuals | chat
  prompt    String   @default("")
  output    String   @default("")
  provider  String   @default("demo")
  model     String?
  words     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

model UsageRecord {
  id        String   @id @default(cuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  kind      String   // "words" | "images"
  amount    Int
  feature   String
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

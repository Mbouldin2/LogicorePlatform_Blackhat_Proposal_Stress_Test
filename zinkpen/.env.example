# =============================================================================
# ZinkPen Environment Configuration
# Copy to .env.local and fill in. The app runs in DEMO MODE when AI/auth keys
# are absent — every feature still works with realistic simulated output.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ZinkPen

# --- AI Providers (any subset; the router picks the best available) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Default model per provider (optional overrides)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-1.5-pro

# --- Supabase Auth + Postgres ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase or any Postgres) for Prisma
DATABASE_URL=
DIRECT_URL=

# --- Stripe Billing ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs per plan (create these in the Stripe dashboard)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_EXECUTIVE=
STRIPE_PRICE_GOVERNMENT=

# =============================================================================
# ZinkPen Environment Configuration
# Copy to .env.local and fill in. The app runs in DEMO MODE when AI/auth keys
# are absent — every feature still works with realistic simulated output.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ZinkPen

# --- Observability -----------------------------------------------------------
# Optional. When set, captureException() forwards errors to this HTTP collector
# (Slack incoming webhook, a Sentry tunnel, or any JSON sink). For full Sentry,
# install @sentry/nextjs and call Sentry.captureException from src/lib/logger.ts.
ERROR_WEBHOOK_URL=

# --- AI Providers (any subset; the router picks the best available) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Default model per provider (optional overrides)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-1.5-pro

# --- Supabase Auth + Postgres ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase or any Postgres) for Prisma
DATABASE_URL=
DIRECT_URL=

# --- Rate limiting -----------------------------------------------------------
# Optional. With Upstash set, limits are durable across serverless instances;
# without it, an in-memory per-instance fallback is used. Set RATE_LIMIT_DISABLED=true
# to turn limiting off entirely (e.g. for load tests).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_DISABLED=

# --- Stripe Billing ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs per plan (create these in the Stripe dashboard)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_EXECUTIVE=
STRIPE_PRICE_GOVERNMENT=
